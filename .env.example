# Copy this file to .env and fill in the values.

# Generate with: npm run gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional but recommended: a password that locks down who can read/edit
# your schedule and trigger pushes. Leave blank only for local testing.
ACCESS_CODE=

PORT=3000
